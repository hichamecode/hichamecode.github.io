<svg width="400" height="500" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="portrait" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e2e8f0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#cbd5e1;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#portrait)"/>
  <circle cx="200" cy="180" r="80" fill="#2563eb" opacity="0.3"/>
  <rect x="120" y="280" width="160" height="120" rx="20" fill="#f59e0b" opacity="0.2"/>
  <text x="200" y="460" text-anchor="middle" fill="#475569" font-family="Arial, sans-serif" font-size="16">Photo Professionnelle</text>
</svg>
